{{ define "title" }}Login{{ end }}

{{ define "content" }}
<div class="grid">
	<div></div>
	<div>
		{{ if .Data }}
			<p style="color: red">{{ .Data }}</p>
		{{ end }}
		<article style="max-width: 400px">
			<h2>Login</h2>
			<form action="/login" method="post">
				<fieldset>
					<input
						autofocus
						name="email"
						type="email"
						placeholder="Email"
						autocomplete="email" />
					<input
						type="password"
						name="password"
						placeholder="Password" />
				</fieldset>

				<input
					type="submit"
					value="Sign In" />
			</form>
		</article>
	</div>
	<div></div>
</div>
{{ end }}